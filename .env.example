# WP SSH Backup configuration.
# Copy this file to .env and fill in your values.

# --- SSH connection -------------------------------------------------------
# Hostname or IP address of the WordPress hosting server.
SSH_HOST=example.com
# SSH port (usually 22).
SSH_PORT=22
# SSH user to log in as.
SSH_USER=myuser
# Path to a private key file for authentication (recommended).
# Leave empty to use your SSH agent's default keys.
SSH_KEY_PATH=
# Optional: password authentication. Prefer keys where possible.
SSH_PASSWORD=

# --- WordPress paths ------------------------------------------------------
# Absolute path to the WordPress root directory on the remote server.
WP_SITE_ROOT=/home/myuser/public_html
# Optional: explicit path to the wp CLI binary if it is not on the
# remote PATH. Leave empty to auto-detect.
WP_CLI_PATH=

# --- Local backup settings ------------------------------------------------
# Local directory where backups are stored.
BACKUP_DIR=./backups
# Delete local backup sets older than this many days after each run.
RETENTION_DAYS=30
