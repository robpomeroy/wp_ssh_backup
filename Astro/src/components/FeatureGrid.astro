---
import Icon from './ui/Icon.astro';
import { features } from '../lib/site';
---

<section id="features" class="mx-auto max-w-6xl scroll-mt-24 px-5 py-20 sm:px-8 sm:py-28">
  <div class="max-w-2xl">
    <p class="eyebrow">Features</p>
    <h2 class="mt-3 text-3xl font-bold sm:text-4xl">
      A backup tool that assumes the network is hostile
    </h2>
    <p class="muted-strong mt-4 text-base leading-relaxed sm:text-lg">
      Most backup scripts trust the transfer and hope for the best. WP SSH Backup
      verifies what it downloaded, refuses untrusted servers, and never overwrites a
      good backup with a bad one.
    </p>
  </div>

  <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      features.map((feature) => (
        <li class="card p-6">
          <span class="grid size-10 place-items-center rounded-xl bg-brand/12 text-brand-2">
            <Icon name={feature.icon} class="size-5" />
          </span>
          <h3 class="mt-4 text-base font-semibold">{feature.title}</h3>
          <p class="muted mt-2 text-sm leading-relaxed">{feature.body}</p>
        </li>
      ))
    }
  </ul>
</section>
