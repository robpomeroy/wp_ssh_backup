---
import { Image } from 'astro:assets';
import Icon from './ui/Icon.astro';
import heroIllustration from '../assets/hero-illustration.png';
import { site } from '../lib/site';

type Props = { version: string; publishedAt: string | null };
const { version, publishedAt } = Astro.props;
---

<section id="top" class="hero-backdrop relative overflow-hidden">
  <div class="hero-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-6xl px-5 pb-20 pt-14 sm:px-8 sm:pb-28 sm:pt-20">
    <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_1fr] lg:gap-10">
      <div class="reveal">
        <div class="flex flex-wrap items-center gap-2">
          <span class="chip !border-accent/30 !bg-accent/10 !text-accent-2">
            <span class="size-1.5 rounded-full bg-accent-2"></span>
            v{version}
          </span>
          <span class="chip">
            <Icon name="github" class="size-3.5" /> Open source · GPLv3
          </span>
        </div>

        <h1 class="mt-6 text-[2.6rem] font-bold leading-[1.05] sm:text-6xl lg:text-[4.1rem]">
          WP <span class="text-accent-2">SSH</span> Backup
        </h1>

        <p class="mt-5 max-w-xl text-lg leading-relaxed text-[var(--muted-strong)] sm:text-xl">
          Automated, secure, and reliable backups for your WordPress site — files and
          database, straight over SSH, verified byte for byte.
        </p>

        <ul class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-[var(--muted)]">
          <li class="flex items-center gap-1.5"><Icon name="check" class="size-4 text-accent-2" /> Full site backups</li>
          <li class="flex items-center gap-1.5"><Icon name="check" class="size-4 text-accent-2" /> Over SSH</li>
          <li class="flex items-center gap-1.5"><Icon name="check" class="size-4 text-accent-2" /> Open source</li>
        </ul>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a href={site.latestRelease} class="btn btn-primary !px-6 !py-3.5 text-base">
            <Icon name="download" class="size-[18px]" />
            Download for free
          </a>
          <a href={site.repo} class="btn btn-ghost !px-6 !py-3.5 text-base">
            <Icon name="github" class="size-[18px]" />
            View on GitHub
          </a>
        </div>

        <p class="muted mt-4 text-xs">
          No Python required — standalone binaries for Linux, Windows and macOS.
          {publishedAt && <span class="ml-1">Released {publishedAt}.</span>}
        </p>
      </div>

      <div class="reveal reveal-2 relative">
        <div
          class="absolute -inset-6 -z-10 rounded-[2rem] bg-gradient-to-tr from-brand/25 via-transparent to-accent/20 blur-2xl"
          aria-hidden="true"
        >
        </div>
        <div
          class="overflow-hidden rounded-2xl border border-white/15 bg-white shadow-[0_30px_80px_-30px_rgba(0,0,0,0.85)] ring-1 ring-black/5"
        >
          <Image
            src={heroIllustration}
            alt="A WordPress site on a laptop being transferred over SSH to a backup server"
            widths={[480, 720, 936]}
            sizes="(min-width: 1024px) 520px, 92vw"
            format="avif"
            quality={82}
            loading="eager"
            fetchpriority="high"
            class="h-auto w-full"
          />
        </div>
      </div>
    </div>
  </div>
</section>
