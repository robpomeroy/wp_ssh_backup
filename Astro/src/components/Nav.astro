---
import Icon from './ui/Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { nav, site } from '../lib/site';

type Props = { version: string };
const { version } = Astro.props;
---

<header
  class="sticky top-0 z-40 border-b border-[var(--border)] bg-[color-mix(in_oklab,var(--page-bg)_82%,transparent)] backdrop-blur-xl"
>
  <nav class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-5 sm:px-8" aria-label="Main">
    <a href="#top" class="flex items-center gap-2.5 font-semibold tracking-tight">
      <span
        class="grid size-8 place-items-center rounded-lg bg-gradient-to-br from-brand to-brand-2 text-white shadow-[0_6px_18px_-8px_rgba(30,111,217,0.9)]"
      >
        <Icon name="database" class="size-[18px]" />
      </span>
      <span class="text-[0.95rem]">WP <span class="text-accent-2">SSH</span> Backup</span>
    </a>

    <ul class="ml-auto hidden items-center gap-1 md:flex">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="rounded-lg px-3 py-2 text-sm text-[var(--muted-strong)] transition hover:bg-[var(--surface-2)] hover:text-[var(--page-fg)]"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="ml-auto flex items-center gap-2 md:ml-0">
      <a
        href={site.repo}
        class="hidden size-10 place-items-center rounded-xl border border-[var(--border)] text-[var(--muted-strong)] transition hover:text-[var(--page-fg)] sm:grid"
        aria-label="WP SSH Backup on GitHub"
      >
        <Icon name="github" class="size-[18px]" />
      </a>
      <ThemeToggle />
      <a href={site.latestRelease} class="btn btn-primary hidden !px-4 !py-2.5 text-sm sm:inline-flex">
        <Icon name="download" class="size-4" />
        Download
        <span class="rounded-md bg-black/15 px-1.5 py-0.5 font-mono text-[0.7rem] font-medium">
          v{version}
        </span>
      </a>
      <button
        type="button"
        id="nav-toggle"
        class="grid size-10 place-items-center rounded-xl border border-[var(--border)] text-[var(--muted-strong)] md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" class="size-[18px]" />
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-[var(--border)] md:hidden">
    <ul class="mx-auto max-w-6xl px-5 py-3 sm:px-8">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="block rounded-lg px-3 py-2.5 text-sm text-[var(--muted-strong)] hover:bg-[var(--surface-2)] hover:text-[var(--page-fg)]"
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="mt-2 border-t border-[var(--border)] pt-3">
        <a href={site.latestRelease} class="btn btn-primary w-full">
          <Icon name="download" class="size-4" /> Download v{version}
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
