---
import Icon from './ui/Icon.astro';

const points = [
  {
    title: 'Unknown host keys are rejected',
    body: 'Never silently accepted. Authorise a server explicitly with authorize_host.py, which shows its SHA-256 fingerprint for you to verify out-of-band.',
  },
  {
    title: 'Credentials never hit the command line',
    body: 'Database passwords are passed through a temporary option file created owner-only (0600) on the server, then deleted immediately after the dump.',
  },
  {
    title: 'Restore validates before it writes',
    body: 'Archive members are checked against the local copy, and the existing tree is audited for links that extraction would traverse or replace.',
  },
] as const;
---

<section class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-24">
  <div
    class="relative overflow-hidden rounded-3xl border border-[var(--border)] bg-gradient-to-br from-brand/12 via-[var(--surface)] to-accent/10 p-8 sm:p-12"
  >
    <div class="max-w-2xl">
      <p class="eyebrow">Security</p>
      <h2 class="mt-3 text-3xl font-bold sm:text-4xl">Built for a hostile network</h2>
      <p class="muted-strong mt-4 text-base leading-relaxed">
        A backup contains your entire site and its database credentials. WP SSH Backup
        treats that as the threat it is.
      </p>
    </div>

    <ul class="mt-10 grid gap-6 sm:grid-cols-3">
      {
        points.map((point) => (
          <li>
            <span class="grid size-9 place-items-center rounded-lg bg-accent/15 text-accent-2">
              <Icon name="shield" class="size-[18px]" />
            </span>
            <h3 class="mt-3 text-sm font-semibold">{point.title}</h3>
            <p class="muted mt-2 text-sm leading-relaxed">{point.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
